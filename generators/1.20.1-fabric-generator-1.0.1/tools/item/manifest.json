{
    "id": "item",
    "name": "Item",
    "version": "1.0.4",
    "description": "Generates a basic item.",
    "supported": true,

    "categories": [
        {
            "id": "display",
            "label": "Display Setup"
        },

        {
            "id": "additional",
            "label": "Additional Content"
        }
    ],

    "forms": [
        {
            "id": "registry_name",
            "label": "Registry Name",
            "type": "string",
            "placeholder": "diamond",
            "category": "display"
        },

        {
            "id": "display_name",
            "label": "Display Name",
            "type": "string",
            "placeholder": "Diamond",
            "category": "display"
        },

        {
            "id": "texture",
            "label": "Texture",
            "type": "texture",
            "category": "display"
        },

        {
            "id": "model_source",
            "label": "Model Source",
            "type": "select",
            "values": [
                "default",
                "custom"
            ],
            "default": "default",
            "category": "display"
        },

        {
            "id": "custom_model",
            "label": "Custom Model",
            "type": "model",
            "visible_if": {
                "field": "model_source",
                "equals": "custom"
            },
            "category": "display"
        },

        {
            "id": "max_stack_size",
            "label": "Max Stack Size",
            "type": "number",
            "default": 64,
            "category": "additional"
        },

        {
            "id": "creative_inventory",
            "label": "Creative Inventory",
            "type": "select",
            "values": [
                "ingredients",
                "combat",
                "tools",
                "food_and_drink",
                "building_blocks",
                "natural",
                "functional",
                "redstone",
                "colored_blocks",
                "operator",
                "none"
            ],
            "default": "ingredients",
            "category": "additional"
        },

        {
            "id": "music_disc",
            "label": "Make Music Disc",
            "type": "boolean",
            "default": false,
            "category": "additional"
        },

        {
            "id": "music_disc_description",
            "label": "Disc Description",
            "type": "string",
            "placeholder": "Artist - Track Name",
            "visible_if": {
                "field": "music_disc",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "music_disc_subtitle",
            "label": "Sound Subtitle",
            "type": "string",
            "placeholder": "Music disc plays",
            "visible_if": {
                "field": "music_disc",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "music_disc_sound",
            "label": "Music Disc Audio",
            "type": "audio",
            "visible_if": {
                "field": "music_disc",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "music_disc_length_seconds",
            "label": "Fallback Disc Length Seconds",
            "type": "number",
            "default": 120,
            "visible_if": {
                "field": "music_disc",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "music_disc_auto_sync_length",
            "label": "Auto Sync Disc Length",
            "type": "boolean",
            "default": true,
            "visible_if": {
                "field": "music_disc",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "music_disc_comparator_output",
            "label": "Comparator Output",
            "type": "number",
            "default": 1,
            "visible_if": {
                "field": "music_disc",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "food_enabled",
            "label": "Add Food Attachment",
            "type": "boolean",
            "default": false,
            "category": "additional"
        },

        {
            "id": "consumed_result_enabled",
            "label": "Add Consumed Result",
            "type": "boolean",
            "default": false,
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "consumed_result_source",
            "label": "Consumed Result Source",
            "type": "select",
            "values": [
                "vanilla",
                "this_mod",
                "other_mod"
            ],
            "default": "vanilla",
            "visible_if": {
                "field": "consumed_result_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "consumed_result_item",
            "label": "Consumed Result Item",
            "type": "element_reference",
            "source_field": "consumed_result_source",
            "visible_if": {
                "field": "consumed_result_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "nutrition",
            "label": "Sustenance",
            "type": "number",
            "default": 4,
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "saturation_modifier",
            "label": "Saturation Modifier",
            "type": "number",
            "default": 0.3,
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "use_animation",
            "label": "Use Animation",
            "type": "select",
            "values": [
                "eat",
                "drink"
            ],
            "default": "eat",
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "use_duration_ticks",
            "label": "Animation Duration (Ticks)",
            "type": "number",
            "default": 32,
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "always_edible",
            "label": "Always Edible",
            "type": "boolean",
            "default": false,
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        },

        {
            "id": "pet_food",
            "label": "Can Be Fed To Pets",
            "type": "boolean",
            "default": false,
            "visible_if": {
                "field": "food_enabled",
                "equals": true
            },
            "category": "additional"
        }
    ]
}
